import BinaryMatrixAddress

set_option autoImplicit false

/-! Explicit binary forward/inverse addresses for every tensor-power depth.
Strides are generated by binary multiplication, not an unpriced Nat.pow.
Recomputing strides at each level is allowed and charged; the resulting
quartic logarithmic bound is independent of the number of table entries.
Array routing and global evaluator integration remain separate. -/
namespace ThinMatrix.BinaryPowerAddress
open BinaryCell BinaryMultiplierAdapter BinaryModularCell
open PolynomialDegeneration RecursiveTable

/-- Binary stride generation, including serialization and final decoding. -/
def stride (q k : ℕ) : Result ℕ :=
  let base := encodeInteger (q:ℤ)
  let out := BinaryRecursiveRecovery.power base.value k
  let result := decodeUnsigned out.value
  ⟨result.value,base.bitSteps+out.bitSteps+result.bitSteps+out.control+8⟩

theorem stride_value (q k : ℕ) : (stride q k).value=q^k := by
  simp only [stride,decodeUnsigned_value,BinaryRecursiveRecovery.power_view]
  change (((encodeInteger (q:ℤ)).value.view)^k).natAbs=_
  rw [encodeInteger_view,Int.natAbs_pow,Int.natAbs_natCast]

theorem stride_bits (q k W : ℕ) (hq : 0 < q)
    (hqw : q.size ≤ W) (hkw : (q^k).size ≤ W) :
    (stride q k).bitSteps ≤ 1024*(k+1)*(W+1)^2 := by
  have hv : view (encodeInteger (q:ℤ)).value=q := encodeInteger_view _
  have hb := encodeInteger_cost (q:ℤ)
  simp only [Int.natAbs_natCast] at hb
  have hb' := hb.trans (Nat.mul_le_mul_left 10 (Nat.pow_le_pow_left (Nat.add_le_add_right hqw 1) 2))
  have hp := BinaryRecursiveRecovery.power_bits (encodeInteger (q:ℤ)).value k W
    (by simpa only [hv,Int.natAbs_natCast] using (show 1 ≤ q by omega))
    (by simpa only [hv,Int.natAbs_natCast] using hkw)
  have hd := decodeUnsigned_price W (BinaryRecursiveRecovery.power (encodeInteger (q:ℤ)).value k).value
    (by simpa only [BinaryRecursiveRecovery.power_view,hv,Int.natAbs_pow,Int.natAbs_natCast] using hkw)
  simp only [stride,BinaryRecursiveRecovery.power_control]
  unfold BackendScalarBits.backendScalarUnit BackendScalarBits.scalarUnit at hp
  nlinarith [Nat.mul_le_mul_left (8*k+10) (show 1 ≤ (W+1)^2 from Nat.one_le_pow 2 _ (by omega))]

def rank (q : ℕ) : (k : ℕ) → PowerIndex (Fin q) k → Result ℕ
  | 0,_ => ⟨0,1⟩
  | k+1,x =>
      let rest := rank q k x.2
      let size := stride q k
      let out := BinaryMatrixAddress.join size.value x.1.val rest.value
      ⟨out.value,rest.bitSteps+size.bitSteps+out.bitSteps+8⟩

theorem rank_value (q k : ℕ) (x : PowerIndex (Fin q) k) :
    (rank q k x).value=((power (fin q) k).index x).val := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [rank,BinaryMatrixAddress.join_value,stride_value,ih]
    change _ = ((power (fin q) k).index x.2).val + (power (fin q) k).size*x.1.val
    exact congrArg (fun n => ((power (fin q) k).index x.2).val+n*x.1.val)
      (power_size (fin q) k).symm

theorem rank_lt (q k : ℕ) (x : PowerIndex (Fin q) k) : (rank q k x).value < q^k := by
  rw [rank_value]
  simpa only [power_size,fin] using ((power (fin q) k).index x).isLt

def unrank (q : ℕ) (hq : 0 < q) : (k : ℕ) → Fin (q^k) → Result (PowerIndex (Fin q) k)
  | 0,_ => ⟨PUnit.unit,1⟩
  | k+1,x =>
      let size := stride q k
      let cut := BinaryMatrixAddress.split size.value x.val
      have hc : cut.value=(x.val/q^k,x.val%q^k) := by
        dsimp only [cut,size]
        rw [BinaryMatrixAddress.split_value _ _ (by rw [stride_value];positivity),stride_value]
      let head : Fin q := ⟨cut.value.1,by
        rw [hc]
        exact (Nat.div_lt_iff_lt_mul (pow_pos hq k)).mpr (by simpa only [pow_succ'] using x.isLt)⟩
      let tail : Fin (q^k) := ⟨cut.value.2,by rw [hc];exact Nat.mod_lt _ (pow_pos hq k)⟩
      let rest := unrank q hq k tail
      ⟨(head,rest.value),size.bitSteps+cut.bitSteps+rest.bitSteps+8⟩

theorem rank_unrank (q : ℕ) (hq : 0 < q) (k : ℕ) (x : Fin (q^k)) :
    (rank q k (unrank q hq k x).value).value=x.val := by
  induction k with
  | zero => have h := x.isLt; simp only [pow_zero] at h; simp only [rank];omega
  | succ k ih =>
    simp only [unrank,rank,BinaryMatrixAddress.join_value,stride_value,ih]
    rw [BinaryMatrixAddress.split_value _ _ (pow_pos hq k)]
    exact Nat.mod_add_div _ _

theorem unrank_value (q : ℕ) (hq : 0 < q) (k : ℕ) (x : Fin (q^k)) :
    (unrank q hq k x).value=(power (fin q) k).index.symm (Fin.cast (by simp [fin]) x) := by
  apply (power (fin q) k).index.injective
  rw [Equiv.apply_symm_apply]
  apply Fin.ext
  rw [←rank_value,rank_unrank]
  rfl

theorem rank_bits (q k W : ℕ) (hq : 0 < q) (hqw : q.size ≤ W)
    (hkw : (q^k).size ≤ W) (x : PowerIndex (Fin q) k) :
    (rank q k x).bitSteps ≤ 8192*(k+1)^2*(W+1)^2 := by
  induction k with
  | zero => simp only [rank,zero_add,one_pow,mul_one]; nlinarith
  | succ k ih =>
    have hs : (q^k).size ≤ W := (Nat.size_le_size
      (Nat.pow_le_pow_right hq (Nat.le_succ k))).trans hkw
    have ht := ih hs x.2
    have hp := stride_bits q k W hq hqw hs
    have hj := BinaryMatrixAddress.join_bits (stride q k).value x.1.val (rank q k x.2).value W
      (by simpa only [stride_value] using hs)
      ((Nat.size_le_size x.1.isLt.le).trans hqw)
      ((Nat.size_le_size (rank_lt q k x.2).le).trans hs)
    simp only [rank]
    nlinarith [Nat.mul_le_mul_left 8 (show 1 ≤ (W+1)^2 from Nat.one_le_pow 2 _ (by omega))]

theorem unrank_bits (q k W : ℕ) (hq : 0 < q) (hqw : q.size ≤ W)
    (hkw : (q^k).size ≤ W) (x : Fin (q^k)) :
    (unrank q hq k x).bitSteps ≤ 8192*(k+1)^2*(W+1)^2 := by
  induction k with
  | zero => simp only [unrank,zero_add,one_pow,mul_one]; nlinarith
  | succ k ih =>
    have hs : (q^k).size ≤ W := (Nat.size_le_size
      (Nat.pow_le_pow_right hq (Nat.le_succ k))).trans hkw
    have hp := stride_bits q k W hq hqw hs
    have hc := BinaryMatrixAddress.split_bits (stride q k).value x.val W
      (by simpa only [stride_value] using hs) ((Nat.size_le_size x.isLt.le).trans hkw)
    have ht := ih hs
    simp only [unrank]
    have hh := ht ⟨(BinaryMatrixAddress.split (stride q k).value x.val).value.2,by
      rw [BinaryMatrixAddress.split_value _ _ (by rw [stride_value];positivity),stride_value]
      exact Nat.mod_lt _ (pow_pos hq k)⟩
    nlinarith

def width (q k : ℕ) := (k+1)*q.size+1

theorem width_bounds (q k : ℕ) : q.size ≤ width q k ∧ (q^k).size ≤ width q k := by
  have hp := BinaryRetainedBounds.size_power q k
  dsimp [width]
  constructor <;> nlinarith

theorem rank_uniform (q k : ℕ) (hq : 0 < q) (x : PowerIndex (Fin q) k) :
    (rank q k x).bitSteps ≤ 8192*(k+1)^2*(width q k+1)^2 :=
  rank_bits q k _ hq (width_bounds q k).1 (width_bounds q k).2 x

theorem unrank_uniform (q k : ℕ) (hq : 0 < q) (x : Fin (q^k)) :
    (unrank q hq k x).bitSteps ≤ 8192*(k+1)^2*(width q k+1)^2 :=
  unrank_bits q k _ hq (width_bounds q k).1 (width_bounds q k).2 x

#print axioms stride_value
#print axioms stride_bits
#print axioms rank_value
#print axioms rank_lt
#print axioms rank_unrank
#print axioms unrank_value
#print axioms rank_bits
#print axioms unrank_bits
#print axioms width_bounds
#print axioms rank_uniform
#print axioms unrank_uniform
end ThinMatrix.BinaryPowerAddress
